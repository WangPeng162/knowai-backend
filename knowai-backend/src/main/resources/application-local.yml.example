# 复制本文件为 application-local.yml，并填入你自己的配置
# 注意：application-local.yml 已在 .gitignore 中排除，不会被提交到 Git
spring:
  datasource:
    username: root
    password: 你的MySQL密码
aliyun:
  oss:
    endpoint: oss-cn-shenzhen.aliyuncs.com
    access-key-id: 你的AccessKeyId
    access-key-secret: 你的AccessKeySecret
    bucket-name: knowai-image-storage
