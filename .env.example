# ============================================================
# KnowAI 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
# ============================================================

# ---------- 数据库 ----------
# MySQL root 密码（容器首次初始化时使用，之后改这里的值不影响已有数据卷）
MYSQL_ROOT_PASSWORD=knowai123

# ---------- 大模型（必填）----------
# 阿里云百炼 API Key：对话 / 向量化 / 精排都依赖它
# 获取：https://bailian.console.aliyun.com/  → API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---------- 注册邀请码 ----------
# 配置后，注册接口必须带正确邀请码才能注册（防止陌生人注册消耗 LLM 额度）
# 留空则不校验（适合本地开发）
KNOWAI_INVITE_CODE=knowai-demo-2026

# ---------- 阿里云 OSS（上传文档必填）----------
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=LTAIxxxxxxxxxxxxxx
ALIYUN_OSS_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALIYUN_OSS_BUCKET_NAME=your-bucket-name

# ---------- 端口（可选，避开本机已占用端口）----------
WEB_PORT=8000            # 前端/网关访问端口 → http://localhost:8000
BACKEND_PORT=18080       # 后端调试端口（Swagger）
MYSQL_PORT=3307          # 数据库（本机已有 MySQL 时避开 3306）
QDRANT_HTTP_PORT=6333    # Qdrant HTTP（本机已有 Qdrant 时换个端口）
